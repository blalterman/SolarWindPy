# The sdist starts from every git-tracked file (setuptools_scm's file finder).
# It keeps what packagers such as conda-forge rebuild and test from (the
# package, its data, tests/, docs/source/) and drops development-only material.
include CITATION.rst
include LICENSE
include README.rst
include src/solarwindpy/solar_activity/sunspot_number/ssn_extrema.csv

prune .claude
prune .github
prune docs/dispatches
prune tmp
prune spike

# Purge-system sidecars declare when a working file is spent; they belong to
# the repository, not to the installed package, so they stay out of the sdist
# and therefore out of the wheel built from it.
recursive-exclude src *.spent-when
